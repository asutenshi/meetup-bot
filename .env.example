# Telegram
BOT_TOKEN=

# chat_id получателя для разового smoke-теста (scripts/smoke_test_bot.py)
TEST_CHAT_ID=

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://meetup_bot:meetup_bot@postgres:5432/meetup_bot
POSTGRES_USER=meetup_bot
POSTGRES_PASSWORD=meetup_bot
POSTGRES_DB=meetup_bot

# Public HTTPS domain (Tailscale Funnel / reverse proxy), used for the webhook URL and Web App
PUBLIC_BASE_URL=https://example.com

# BotFather Mini App short name (/newapp). Enables the "📄 Подробности мероприятия"
# link under event announcements (t.me/<bot>/<name>?startapp=...). Optional —
# without it the button is simply not shown.
WEBAPP_SHORT_NAME=app

# Reminders worker: minutes between APScheduler passes (TZ §3.4, 15–30 recommended)
WORKER_POLL_INTERVAL_MINUTES=20

# Web App: age of Telegram initData auth_date after which it is considered stale
# (seconds, TZ §3.2). By default only a WARNING log threshold — the request still
# passes, because Telegram clients cache launch params and never refresh
# auth_date. Set WEBAPP_INIT_DATA_REJECT_STALE=true to hard-reject with 401
# expired; WEBAPP_INIT_DATA_MAX_AGE=0 to skip the age check entirely.
WEBAPP_INIT_DATA_MAX_AGE=604800
WEBAPP_INIT_DATA_REJECT_STALE=false

# Root log level for the JSON logs written to stdout (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO
